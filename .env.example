# ═══════════════════════════════════════════════════════════════
#  Template. Copy to .env.local and fill in real values there.
#  Never put real keys in this file — it IS committed to git.
# ═══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings → API Keys → "Secret keys" → Reveal (sb_secret_...)
# On older projects this is the legacy `service_role` JWT instead.
# SERVER ONLY — never exposed to the browser. All data access goes
# through this key behind the app's own session layer.
#
# Note: the anon / publishable key is NOT needed. This app never
# queries Supabase from the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# OPTIONAL — only for `npm run db:push`. Not needed if you set the
# database up by pasting supabase/SETUP.sql into the SQL Editor.
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres

# ── Auth ──────────────────────────────────────────────────────
# openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-string

# First admin, created by `npm run db:push`
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=ChangeMe@123

# ── Keep-alive cron (stops a free-tier project pausing) ───────
# openssl rand -base64 32
CRON_SECRET=another-long-random-string

# ── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Country code + number, digits only, no + or spaces
NEXT_PUBLIC_WHATSAPP_SUPPORT=919000000000
